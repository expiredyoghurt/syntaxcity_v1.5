rules_version = '2';

// The client never talks to Firestore directly — every read and write goes
// through the Cloud Function in functions/index.js, which uses the Admin SDK
// and therefore bypasses these rules entirely. Denying all direct client
// access here is intentional: it's the equivalent of the old Cloudflare
// Worker's KV namespace not being reachable except through the Worker itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
